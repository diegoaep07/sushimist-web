---
import { SITE_CONFIG } from '../config';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<button id="whatsapp-order-btn" class={`order-btn ${className}`}>
  Ordenar por WhatsApp
</button>

<script define:vars={{ whatsappNumber: SITE_CONFIG.whatsappNumber }}>
  function setupWhatsAppButton() {
    const btn = document.getElementById('whatsapp-order-btn');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const cart = JSON.parse(sessionStorage.getItem('cart') || '[]');
      const address = sessionStorage.getItem('delivery_address') || '';
      const instructions = sessionStorage.getItem('special_instructions') || '';
      let total = 0 

      if (cart.length === 0) {
        alert('Your cart is empty!');
        return;
      }
      
      cart.forEach((item) => {
        total+=(item.cant*item.price)
      })
      const itemsList = cart.map(item => `${item.cant} ${item.name}`).join(', ');
      let message = `Hola, quiero ordenar esto: ${itemsList}. Total: ${total}`;
      
      message += `\n\n📍 Mi Dirección: ${address}`;
      if (instructions) {
        message += `\n\n📝 Nota: ${instructions}`;
      }
      
      const encodedMessage = encodeURIComponent(message);
      
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;
      
      window.open(whatsappUrl, '_blank');
      
      // Optional: Clear cart after order
      // sessionStorage.removeItem('cart');
      // window.dispatchEvent(new Event('cart-updated'));
    });
  }

  setupWhatsAppButton();
  document.addEventListener('astro:page-load', setupWhatsAppButton);
</script>

<style>
  .order-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem;
    background: #25d366;
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
    border-radius: var(--radius);
    text-align: center;
    transition: filter 0.2s;
  }
  
  .order-btn::before {
    content: "";
    display: inline-block;
    height: 24px;
    width: 24px;
    background-color: currentColor;
    margin-right: 0.2rem;

    mask: url('../assets/icons/brand-whatsapp.svg');
    -webkit-mask: url('../assets/icons/brand-whatsapp.svg');
  }

  .order-btn:hover {
    filter: brightness(0.9);
  }

  .order-btn:active {
    transform: scale(0.98);
  }
</style>
