---
import FoodCard from './FoodCard.astro'
import { getCollection } from 'astro:content'

const ALL_PLATES = await getCollection('MENU_DATA')
const RECOMENDEDS = ALL_PLATES.filter( (plate) => plate.data.recomended)
---
<div class="recomendeds-section">
  <span class="category">ESPECIALIDADES</span>
  <h2 class="house-favs dark-heading">FAVORITOS DE LA CASA</h2>
  <div class="recomendeds-list">
  {
  RECOMENDEDS.map( (item) => (
    <FoodCard item={item}/>
    )
  )
  }
  </div>
</div>


<style>
  .category {
    color: var(--matcha-green);
    border-bottom: 1px solid currentColor;
    font-family: 'bonveno';
    font-size: 
  }
  .recomendeds-section {
    margin: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .recomendeds-list {
    display: flex;
    flex-direction: column;
    width: 98%;
  }

  .house-favs {
    font-size: 1.5rem; 
  }

  @media (min-width: 600px) {
    .recomendeds-list {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
