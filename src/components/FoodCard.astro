---
import { Image } from 'astro:assets';
import { SITE_CONFIG } from '../config';
import { render } from 'astro:content';

const { item } = Astro.props;

const { Content }  = await render(item)

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/menu/*.{jpeg,jpg,png,gif,webp}');
const imagePath = item.data.image ? item.data.image : null;
const hasImage = imagePath && images[imagePath];
---

<article class="food-card" id={item.data.id} data-id={item.data.id} data-name={item.data.name} data-price={item.data.price}>
  <div class="card-image">	
    <Image 
      src={item.data.image} 
      alt={item.data.name} 
      width={400} 
      height={400}
      class="plate-img"
    />
  </div>
  <div class="card-content">
    <div class="card-header">
      <strong class="card-name">{item.data.name}</strong>
      <span class="price">{SITE_CONFIG.currency}{item.data.price.toLocaleString()}</span>
    </div>
    <div class="card-actions">
      <button class="add-to-cart-btn" data-id={item.data.id}></button>
    </div>
  </div>
  <dialog class="food-card-modal" id=`modal-${item.data.id}` data-modalid={item.data.id}>
    <div class="modal-content">
      <button commandfor=`modal-${item.data.id}` command="close" class='close-modal'></button>
      <Image
        src={item.data.image}
        alt={item.data.name}
        class="modal-image"
        layout='constrained'
      />

      <div class="card-content">
        <div class="card-header">
          <strong class="card-name">{item.data.name}</strong>
          <span class="price">${item.data.price.toLocaleString()}</span>
        </div>
        <div class="card-actions">
          <button class="modal add-to-cart-btn" data-it={item.data.id}></button>
        </div>
      </div>
      <div class="modal-description">
        <Content />
      </div>
    </div>
  </dialog>
</article>

<script>
  function setupAddToCartButtons() {
    const buttons = document.querySelectorAll('.add-to-cart-btn');
    
    buttons.forEach(button => {
      // Avoid duplicate listeners
      if (button.getAttribute('data-listener')) return;
      
      button.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const card = target.closest('.food-card') as HTMLElement;
        const id = card.dataset.id;
        const name = card.dataset.name;
        const price = card.dataset.price;

        if (!id || !name || !price) return;

        const cart = JSON.parse(sessionStorage.getItem('cart') || '[]');
        console.log(cart)
        if( cart.length === 0 ){
          cart.push({ id, name, price:parseFloat(price), cant:1 })
        } else {
          cart.forEach((item) => {
            if (item.id === id) {
              item.cant+=1
            } else {
              console.log(cart)
              cart.push({ id, name, price: parseFloat(price), cant:1 })
            }
          })
        }
        // cart.push({ id, name, price: parseFloat(price), cant: 1 });
        sessionStorage.setItem('cart', JSON.stringify(cart));

        // Dispatch event for Layout header to update
        window.dispatchEvent(new Event('cart-updated'));

        // Feedback
        const originalText = target.textContent;
        target.classList.add('added');
        setTimeout(() => {
          target.textContent = originalText;
          target.classList.remove('added');
        }, 1000);
      });
      
      button.setAttribute('data-listener', 'true');
    });
  }

  // Initial setup
  setupAddToCartButtons();
  
  // Re-setup if content changes (Astro transitions or dynamic loading)
  document.addEventListener('astro:page-load', setupAddToCartButtons);

  // Modal Handling
  function modalHandlingSetup() {
    const modals = document.querySelectorAll('.food-card-modal')

    modals.forEach(modal => {
      console.log(modal)
      const card = modal.closest('.food-card') as HTMLElement
      card.querySelector('.card-image').addEventListener('click', () => {
        modal.showModal()
      })
      card.querySelector('.card-header').addEventListener('click', () => {
        modal.showModal()
      })
    })
  }

  modalHandlingSetup()
  document.addEventListener('astro:page-load', modalHandlingSetup)
</script>

<style is:global>
  .food-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 1.2rem;
    overflow: hidden;
    transition: transform 0.2s ease;
    margin: 1rem;
  }

  .card-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(45deg, #f0f0f0, #e0e0e0);
  }

  .plate-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .food-card:hover .plate-img {
    transform: scale(1.05);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .card-content {
    padding: var(--space-sm);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .card-name {
    font-family: "belgiano";
    font-size: 1.5rem;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .price {
    font-weight: 700;
    font-family: serif;
    color: var(--accent);
  }

  .item-content {
    font-size: var(--body-size);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .add-to-cart-btn {
    width: 100%;
    padding: 0.55rem;
    background: var(--primary);
    color: var(--secondary);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: var(--small-size);
    transition: background 0.2s;
    display: flex;
  }

  .card-actions {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .add-to-cart-btn::before {
    content: "";
    height: 24px;
    width: 24px;
    display: inline-block;

    mask: url('../assets/icons/plus.svg');
    -webkit-mask: url('../assets/icons/plus.svg');

    background-color: var(--pale-green);
  }

  .add-to-cart-btn:active {
    transform: scale(0.98);
  }

  .add-to-cart-btn.added {
    background: #4c692c;
  }

  .add-to-cart-btn.added::before {
    mask: url('../assets/icons/check.svg');
    -webkit-mask: url('../assets/icons/check.svg');
  }

  .food-card-modal {
    max-width: none;
    max-height: none;
    box-sizing: border-box;
    border: none;
    width: 100vw;
    height: 100vh;
    padding: 0.5rem;
    color: var(--text-color);
    background-color: var(--bg-color);
  }

  .food-card-modal .modal-image {
    margin: 0.5rem auto;
    border-radius: var(--radius);
    object-fit: cover;
    object-position: center;
    width: 98%;
    height: 18rem;
    box-shadow: 0px 0px 0.2rem gray;
  }

  .close-modal {
    display: block;
    background: transparent;
    padding: 0;
    height: 24px;
    width: 24px;
  }

  .close-modal:active {
    border: none;
  }

  .close-modal::before {
    display: inline-block;
    content: '';
    height: 24px;
    width: 24px;

    mask: url('../assets/icons/x.svg') no-repeat center/contain;
    -webkit-mask: url('../assets/icons/x.svg') no-repeat center/contain;

    background-color: var(--accent);
  }

  .modal-description {
    padding-left: 1rem;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border-color);
  }

</style>
