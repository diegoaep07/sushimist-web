---
import { SITE_CONFIG } from '../config';
const currentYear = new Date().getFullYear();
---

<footer class="main-footer">
  <div class="container footer-content">
    <p class="footer-logo">{SITE_CONFIG.name}</p>
    <div class="social-links">
      <a href="#" aria-label="WhatsApp" class="social-link icon whatsapp">WhatsApp</a>
      <a href="#" aria-label="Instagram" class="social-link icon instagram">Instagram</a>
    </div>
    <div class="footer-brand">
      <p>&copy; {currentYear} {SITE_CONFIG.name}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

  <style>
    .main-footer {
      padding: var(--space-md) 0;
      background: var(--dark-primary);
      color: var(--pale-green);
      margin-top: var(--space-lg);
    }

    .footer-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-sm);
    }

    .footer-logo {
      font-family: 'abrilff';
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--bg-color);
      letter-spacing: -0.5px;
    }

    .footer-brand p {
      font-size: var(--small-size);
      color: var(--secondary);
    }

    .social-links {
      display: flex;
      flex-direction: column; 
      gap: var(--space-md);
      align-items: center;
      justify-content: center; 
    }

    .social-link {
      color: var(--secondary);
      text-decoration: none;
      font-size: var(--small-size);
      font-weight: 500;
      transition: color 0.2s;
    }

    .social-link:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .icon {
      display: flex;
      flex-direction: row;
      justify-content: center;
    }

    .icon::before {
      content: "";
      display: inline-block;
      height: 24px;
      width: 24px;
      background-color: currentColor;
      margin-right: 0.2rem;
    }

    .whatsapp::before {
      mask: url('../assets/icons/brand-whatsapp.svg');
      -webkit-mask: url('../assets/icons/brand-whatsapp.svg');
    }

    .instagram::before {
      mask: url('../assets/icons/brand-instagram.svg');
      -webkit-mask: url('../assets/icons/brand-instagram.svg');
    }

    @media (min-width: 768px) {
      .footer-content {
        flex-direction: column; /* Changed to column for single-column style */
        justify-content: center; /* Center content vertically in the column */
        gap: var(--space-lg); /* More space between main elements */
      }
      .social-links {
        align-items: center; /* Keep social links centered */
      }
    }
  </style>
