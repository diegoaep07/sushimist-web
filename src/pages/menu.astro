---
import Layout from '../layouts/Layout.astro';
import FoodCard from '../components/FoodCard.astro';
import { SITE_CONFIG } from '../config';
import { getCollection, render } from 'astro:content'

// Filter available items and group by category in the frontmatter to avoid template parsing issues
const ALL_ITEMS = await getCollection('MENU_DATA')
const renderedItems = await Promise.all(
  ALL_ITEMS.map( async (item) => {
    const { description } = await render(item)
    return {
      ...item,
      description: description
    }
  } )
)

const availableItems = renderedItems.filter((item) => item.data.available);

const groupedMenu = availableItems.reduce( (acc, item) => {
  if (!acc[item.data.category]) acc[item.data.category] = [];
  acc[item.data.category].push(item);
  return acc;
  }, {} as Record<string, typeof availableItems>);
---

<Layout title={SITE_CONFIG.name}>
	<section class="menu">
		<div class="container">
      <h2 class="section-title icon-menu dark-heading">MENÚ</h2>
    </div>

			<!-- Category Navigation -->
      <nav class="category-nav">
        <div class="container">
				{Object.keys(groupedMenu).map((category) => (
					<a href={`#${category.toLowerCase().replace(/\s+/g, '-')}`} class="category-btn">
						{category}
					</a>
          ))}
        </div>
			</nav>

    <div class="container">
			{Object.entries(groupedMenu).map(([category, items]) => (
				<div id={category.toLowerCase().replace(/\s+/g, '-')} class="category-section">
					<h3 class="category-title">{category}</h3>
					<div class="menu-list">
						{items.map((item) => (
							<FoodCard item={item}/>
						))}
					</div>
				</div>
			))}
		</div>
	</section>
</Layout>

<style>
	html {
		scroll-behavior: smooth;
	}
	.hero {
		padding: var(--space-lg) 0;
		background: var(--card-bg);
		border-bottom: 1px solid var(--border-color);
	}
	.hero h1 {
		font-size: var(--h1-size);
		margin-bottom: var(--space-xs);
	}
	.hero p {
		color: var(--text-muted);
	}

  .category-nav {
    font-family: 'belgiano';
		display: flex;
		gap: var(--space-sm);
		overflow-x: auto;
		padding: var(--space-sm) 0;
		margin-bottom: var(--space-lg);
		position: sticky;
		top: 3.8rem; /* Adjust based on header height */
    background: var(--secondary);
    backdrop-filter: blur(5px);
		z-index: 10;
		scrollbar-width: none; /* Hide scrollbar Firefox */
	}

	.category-nav::-webkit-scrollbar {
		display: none; /* Hide scrollbar Chrome/Safari */
	}

	.category-nav .category-btn {
		padding: 0.5rem 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 50px;
		font-size: var(--body-size);
		font-weight: 600;
		white-space: nowrap;
    transition: all 0.2s ease;
    margin-right: 0.5rem;
		color: var(--text-color); /* Ensure text color is applied */
	}

	.category-nav .category-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.menu {
		padding: var(--space-lg) 0;
  }

  .section-title {
    text-align: center;
    font-size: var(--h2-size);
		margin-bottom: var(--space-lg);
		padding-left: var(--space-sm);
  }

  .icon-menu::before {
    content: "";
    display: inline-block;
    height: 24px;
    width: 24px;
    margin-right: 0.2rem;
    background-color: var(--dark-primary);

    mask: url('../assets/icons/bowl-chopsticks.svg');
    -webkit-mask: url('../assets/icons/bowl-chopsticks.svg');
  }

	.category-section {
		margin-bottom: -1rem;
	}

	.category-title {
		font-size: 1.7rem;
		font-weight: 700;
    color: var(--dark-primary);
    margin-bottom: -0.2rem;
		letter-spacing: 1px;
		border-top: 1px solid var(--border-color);
		padding-bottom: var(--space-xs);
	}

	/* Responsive Grid for Menu Items */
	@media (min-width: 600px) {
		.menu-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.menu-list {
			grid-template-columns: repeat(3, 1fr);
		}
		/* Increase container width for larger screens to fit the grid better */
		.container {
			max-width: 1100px;
		}
	}
</style>
