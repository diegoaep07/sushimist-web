---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css'
import FoodCard from '../components/FoodCard.astro';
import { SITE_CONFIG, MENU } from '../config';

// Group menu items by category in the frontmatter to avoid template parsing issues
const groupedMenu = MENU.reduce((acc, item) => {
  if (!acc[item.category]) acc[item.category] = [];
  acc[item.category].push(item);
  return acc;
}, {} as Record<string, typeof MENU>);
---

<Layout title={SITE_CONFIG.name}>
	<section class="hero text-center">
		<div class="container">
			<h1>{SITE_CONFIG.name}</h1>
			<p>{SITE_CONFIG.description}</p>
		</div>
	</section>

	<section class="menu">
		<div class="container">
			<h2 class="section-title">Nuestro Menú</h2>

			<!-- Category Navigation -->
			<nav class="category-nav">
				{Object.keys(groupedMenu).map((category) => (
					<a href={`#${category.toLowerCase().replace(/\s+/g, '-')}`} class="category-btn">
						{category}
					</a>
				))}
			</nav>
			
			{Object.entries(groupedMenu).map(([category, items]) => (
				<div id={category.toLowerCase().replace(/\s+/g, '-')} class="category-section">
					<h3 class="category-title">{category}</h3>
					<div class="menu-list">
						{items.map((item) => (
							<FoodCard 
								id={item.id}
								name={item.name}
								description={item.description}
								price={item.price}
								img={item.img}
							/>
						))}
					</div>
				</div>
			))}
		</div>
	</section>
</Layout>

<style>
	html {
		scroll-behavior: smooth;
	}
	.hero {
		padding: var(--space-lg) 0;
		background: var(--card-bg);
		border-bottom: 1px solid var(--border-color);
	}
	.hero h1 {
		font-size: var(--h1-size);
		margin-bottom: var(--space-xs);
	}
	.hero p {
		color: var(--text-muted);
	}

	.category-nav {
		display: flex;
		gap: var(--space-sm);
		overflow-x: auto;
		padding: var(--space-sm) 0;
		margin-bottom: var(--space-lg);
		position: sticky;
		top: 60px; /* Adjust based on header height */
		background: var(--bg-color);
		z-index: 10;
		scrollbar-width: none; /* Hide scrollbar Firefox */
	}

	.category-nav::-webkit-scrollbar {
		display: none; /* Hide scrollbar Chrome/Safari */
	}

	.category-nav .category-btn {
		padding: 0.5rem 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 50px;
		font-size: var(--small-size);
		font-weight: 600;
		white-space: nowrap;
		transition: all 0.2s ease;
		color: var(--text-color); /* Ensure text color is applied */
	}

	.category-nav .category-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.menu {
		padding: var(--space-lg) 0;
	}
	.section-title {
		font-size: var(--h2-size);
		margin-bottom: var(--space-lg);
		border-left: 4px solid var(--accent);
		padding-left: var(--space-sm);
	}

	.category-section {
		margin-bottom: var(--space-lg);
		scroll-margin-top: 130px; /* Prevent header/nav from covering section title */
	}

	.category-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--primary);
		margin-bottom: var(--space-md);
		text-transform: uppercase;
		letter-spacing: 1px;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: var(--space-xs);
	}

	/* Responsive Grid for Menu Items */
	@media (min-width: 600px) {
		.menu-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.menu-list {
			grid-template-columns: repeat(3, 1fr);
		}
		/* Increase container width for larger screens to fit the grid better */
		.container {
			max-width: 1100px;
		}
	}
</style>
