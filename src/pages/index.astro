---
import Layout from '../layouts/Layout.astro';
import StoreStatus from '../components/StoreStatus.astro';
import { SITE_CONFIG } from '../config';
---

<Layout title={SITE_CONFIG.name}>
  <StoreStatus />
  <section class="landing-hero">
    <div class="container">
      <h1 class="restaurant-name">{SITE_CONFIG.name}</h1>
      <p class="tagline">{SITE_CONFIG.description}</p>
      <a href="/menu" class="btn-primary">Ver Nuestro Menú</a>
    </div>
    <div class="hero-background-image"></div>
  </section>

  <section class="delivery-info">
    <div class="container">
      <div class="info-grid">
        <div class="info-card">
          <h3>Horarios</h3>
          <p>{SITE_CONFIG.openingHours.display}</p>
        </div>
        <div class="info-card">
          <h3>Zona de Entrega</h3>
          <p>{SITE_CONFIG.deliveryArea}</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .landing-hero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: var(--bg-color);
    padding: var(--space-lg) var(--space-sm);
    position: relative; /* Needed for absolute positioning of background image */
    overflow: hidden; /* Hide overflowing parts of the background image */
  }

  .hero-background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    background-size: cover;
    background-position: center;
    opacity: 0.3; /* Adjust as needed */
    z-index: 0; /* Behind other content */
  }

  .landing-hero .container {
    position: relative;
    z-index: 1; /* Ensure content is above the background image */
  }

  .logo-container {
    margin-bottom: var(--space-md);
  }

  .sushi-mist-logo {
    width: 250px; /* Adjust size as needed */
    height: auto;
    margin: 0 auto;
  }

  .restaurant-name {
    font-size: var(--h1-size);
    color: var(--primary);
    margin-bottom: var(--space-sm);
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin: 0 auto var(--space-lg) auto; /* Center the block and add bottom margin */
    max-width: 600px;
    text-align: center;
  }

  .btn-primary {
    display: inline-block;
    padding: 1rem 2rem;
    background: var(--accent);
    color: var(--secondary);
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 1.1rem;
    transition: all 0.2s ease;
  }

  .btn-primary:hover {
    background: var(--secondary);
    color: var(--primary);
    border: 1px solid var(--primary);
  }

  .delivery-info {
    padding: var(--space-lg) 0;
    background: var(--card-bg);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .info-grid {
    display: grid;
    gap: var(--space-md);
  }

  .info-card {
    text-align: center;
    padding: var(--space-md);
  }

  .info-card h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-xs);
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent);
  }

  .info-card p {
    color: var(--text-muted);
  }

  /* Responsive adjustments */
  @media (min-width: 768px) {
    .landing-hero h1 {
      font-size: 4rem;
    }
    .tagline {
      font-size: 1.5rem;
    }
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
