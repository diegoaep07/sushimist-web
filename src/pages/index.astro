---
import Layout from '../layouts/Layout.astro';
import StoreStatus from '../components/StoreStatus.astro';
import Recomendeds from '../components/Recomendeds.astro'

import { SITE_CONFIG } from '../config';
---

<Layout title={SITE_CONFIG.name}>
  <StoreStatus />
  <section class="landing-hero">
    <div class="container">
      <span class="restaurant-category">COCINA JAPONESA</span>
      <h1 class="restaurant-name"><span style="color: var(--text-color)">SUSHI</span> <span class="mist-shadow">MIST</span></h1>
      <p class="tagline">{SITE_CONFIG.description}</p>
      <a href="/menu" class="btn-primary">Ver nuestro menú</a>
    </div>
    <div class="hero-background-image"></div>
  </section>

  <Recomendeds/>
  <a href="/menu" class="btn-primary icon-arrow">Ver menú completo</a>

  <section class="delivery-info">
    <div class="info-card icon clock-icon">
      <p>{SITE_CONFIG.openingHours.display}</p>
    </div>
    <div class="info-card icon bike-icon">
      <p>{SITE_CONFIG.deliveryArea}</p>
    </div>
  </section>
</Layout>

<style>
  .restaurant-category {
    color: var(--matcha-green);
    border-bottom: 1px solid var(--matcha-green);
    font-family: 'bonveno';
  }

  .mist-shadow {
    color: var(--matcha-green);
  }

  .landing-hero {
    min-height: 65vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: var(--bg-color);
    padding: var(--space-lg) var(--space-sm);
    position: relative;
    overflow: hidden;
  }

  .hero-background-image {
    position: absolute;
    top: 8.2rem;
    left: 0;
    width: 100%;
    height: 100%;

    background: url('../assets/hero-background.png');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.7;
    z-index: 0; /* Behind other content */
  }

  .landing-hero .container {
    position: relative;
    z-index: 1; /* Ensure content is above the background image */
  }

  .logo-container {
    margin-bottom: var(--space-md);
  }

  .sushi-mist-logo {
    width: 250px;
    height: auto;
    margin: 0 auto;
  }

  .restaurant-name {
    font-size: var(--h1-size);
    color: var(--primary);
    margin-bottom: -10;
  }

  .tagline {
    font-size: 1.25rem;
    font-family: 'belgiano';
    color: var(--text-muted);
    margin: 0 auto var(--space-lg) auto; /* Center the block and add bottom margin */
    max-width: 600px;
    text-align: center;
  }

  .btn-primary {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0.6rem 0.9rem;
    max-width: 70%;
    background: var(--btn-primary);
    color: var(--text-color);
    border-radius: var(--radius-round);
    font-weight: 300;
    font-size: 1rem;
    transition: all 0.2s ease;
    border: 1px solid transparent;
    font-family: 'belgiano', 'abrilff';
    margin: 0 auto;
    backdrop-filter: blur(3px);
  }

  .btn-primary::after{
    content: "";
    padding: 0 0.15rem;
    display: inline-block;
    height: 24px;
    width: 24px;
    margin-right: 0.15rem;

    mask: url('../assets/icons/bowl-chopsticks.svg') no-repeat center/contain;
    -webkit-mask: url('../assets/icons/bowl-chopsticks.svg') no-repeat center/contain;

    background-color: currentColor;
  }

  .btn-primary.icon-arrow::after {
    mask: url('../assets/icons/arrow-narrow-right.svg');
    -webkit-mask: url('../assets/icons/arrow-narrow-right.svg');
  }

  .btn-primary:hover {
    background: var(--secondary);
    color: var(--primary);
    border: 1px solid var(--primary);
  }
  .btn-primary:hover::before {
    background-color: var(--primary);
  }

  .delivery-info {
    padding: var(--space-lg) 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .info-card {
    text-align: center;
    padding: var(--space-md);
  }

  .icon::before {
    content: "";
    display: inline-block;
    height:24px;
    width:24px;
    background-color:currentColor;
  }

  .clock-icon::before {
    mask: url('../assets/icons/clock.svg');
    -webkit-mask: url('../assets/icons/clock.svg');
  }

  .bike-icon::before {
    mask: url('../assets/icons/motorbike.svg');
    -webkit-mask: url('../assets/icons/motorbike.svg');
  }

  .info-card p {
    color: var(--text-muted);
  }

  /* Responsive adjustments */
  @media (min-width: 768px) {
    .landing-hero h1 {
      font-size: 6rem;
      margin-bottom: -1rem;
    }
    .tagline {
      font-size: 1.5rem;
    }
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
