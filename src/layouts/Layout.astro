---
import { SITE_CONFIG } from '../config';
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
}

const { title = SITE_CONFIG.name } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class={Astro.url.pathname === '/' ? 'landing-page' : ''}>
		<header class="main-header">
			<div class="container header-content">
				<a href="/" class="logo">{SITE_CONFIG.name}</a>
				<nav class="main-nav">
					<!-- Desktop navigation -->
						<div class="nav-links desktop-nav">
							{Astro.url.pathname !== '/menu' && (
								<a href="/menu" class="menu-link">Menú</a>
							)}
							{Astro.url.pathname !== '/cart' && (
								<a href="/cart" class="cart-link">
									Carrito (<span id="cart-count">0</span>)
								</a>
							)}
						</div>

					<!-- Hamburger menu for mobile, conditionally shown on landing page -->
					{Astro.url.pathname === '/' && (
						<button id="hamburger-btn" class="hamburger-btn">
							<span class="hamburger-icon"></span>
							<span class="hamburger-icon"></span>
							<span class="hamburger-icon"></span>
						</button>
					)}
					
					<!-- Mobile navigation overlay -->
					<div id="mobile-nav-overlay" class="mobile-nav-overlay">
						<button id="close-mobile-nav" class="close-mobile-nav">&times;</button>
						<div class="mobile-nav-links">
							<a href="/menu" class="menu-link">Menú</a>
							<a href="/cart" class="cart-link">
								Carrito (<span id="mobile-cart-count">0</span>)
							</a>
						</div>
					</div>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<Footer />

		<script>
			// Basic cart count initialization
			function updateCartCount() {
				const cart = JSON.parse(sessionStorage.getItem('cart') || '[]');
				const countElement = document.getElementById('cart-count');
				const mobileCountElement = document.getElementById('mobile-cart-count');

				if (countElement) {
					countElement.textContent = cart.length.toString();
				}
				if (mobileCountElement) {
					mobileCountElement.textContent = cart.length.toString();
				}
			}

			// Hamburger menu functionality
			const hamburgerBtn = document.getElementById('hamburger-btn');
			const closeMobileNavBtn = document.getElementById('close-mobile-nav');
			const mobileNavOverlay = document.getElementById('mobile-nav-overlay');

			if (hamburgerBtn && mobileNavOverlay) {
				hamburgerBtn.addEventListener('click', () => {
					mobileNavOverlay.classList.add('active');
					document.body.style.overflow = 'hidden'; // Prevent scrolling when nav is open
				});
			}

			if (closeMobileNavBtn && mobileNavOverlay) {
				closeMobileNavBtn.addEventListener('click', () => {
					mobileNavOverlay.classList.remove('active');
					document.body.style.overflow = '';
				});
			}

			// Close mobile nav when a link is clicked
			mobileNavOverlay?.querySelectorAll('a').forEach(link => {
				link.addEventListener('click', () => {
					mobileNavOverlay.classList.remove('active');
					document.body.style.overflow = '';
				});
			});

			// Listen for cart updates
			window.addEventListener('cart-updated', updateCartCount);
			// Initial check
			updateCartCount();
		</script>

		<style>
			.main-header {
				padding: var(--space-sm) 0;
				background: var(--card-bg);
				border-bottom: 1px solid var(--border-color);
				position: sticky;
				top: 0;
				z-index: 100;
			}
			.header-content {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap; /* Allow items to wrap on smaller screens */
			}

			.logo {
				font-weight: 700;
				font-size: 1.2rem;
				letter-spacing: -0.5px;
				color: var(--text-color);
				margin-right: var(--space-sm); /* Prevent logo from touching nav */
			}

			.nav-links {
				display: flex;
				gap: var(--space-xs); /* Space between nav items */
			}

			.cart-link,
			.menu-link {
				font-weight: 500;
				padding: 0.5rem 1rem;
				border-radius: var(--radius);
				font-size: var(--small-size);
				white-space: nowrap; /* Prevent text wrapping inside buttons */
			}

			.cart-link {
				background: var(--primary);
				color: var(--secondary);
			}

			.menu-link {
				background: transparent;
				color: var(--primary);
				border: 1px solid var(--primary);
			}

			/* Hamburger Button */
			.hamburger-btn {
				display: none; /* Hidden by default */
				width: 30px;
				height: 20px;
				background: none;
				border: none;
				cursor: pointer;
				flex-direction: column;
				justify-content: space-between;
				padding: 0;
			}

			.hamburger-icon {
				display: block;
				width: 100%;
				height: 2px;
				background: var(--primary);
				border-radius: 2px;
			}

			/* Mobile Navigation Overlay */
			.mobile-nav-overlay {
				display: flex;
				flex-direction: column;
				position: fixed;
				top: 0;
				left: -100%; /* Off-screen by default */
				width: 100%;
				height: 100%;
				background: var(--bg-color);
				z-index: 200; /* Above header */
				transition: left 0.3s ease-in-out;
				padding: var(--space-lg);
				box-sizing: border-box;
			}

			.mobile-nav-overlay.active {
				left: 0; /* Slide in */
			}

			.close-mobile-nav {
				font-size: 2.5rem;
				background: none;
				border: none;
				color: var(--primary);
				position: absolute;
				top: var(--space-sm);
				right: var(--space-sm);
				cursor: pointer;
			}

			.mobile-nav-links {
				display: flex;
				flex-direction: column;
				gap: var(--space-md);
				margin-top: var(--space-lg);
				align-items: flex-start;
			}

			.mobile-nav-links .menu-link,
			.mobile-nav-links .cart-link {
				font-size: 1.5rem; /* Larger links for mobile menu */
				width: 100%;
				text-align: left;
				padding: var(--space-sm) 0;
				background: transparent; /* Override button background */
				color: var(--primary); /* Use primary text color */
				border: none; /* Remove button border */
				border-radius: 0;
			}

			.mobile-nav-links .cart-link {
				border: 1px solid var(--primary);
				border-radius: var(--radius);
				padding-left: var(--space-sm);
			}

			/* Responsive adjustments */
			/* Default mobile styles for desktop-nav when on non-landing pages */
			.desktop-nav {
				display: flex; /* Always show desktop-nav by default (mobile-first for non-landing pages) */
				gap: var(--space-xs);
				flex-wrap: wrap;
				justify-content: flex-end;
			}

			@media (max-width: 767px) {
				.landing-page .desktop-nav {
					display: none; /* Hide desktop nav ONLY on landing page mobile */
				}

				.landing-page .hamburger-btn {
					display: flex; /* Show hamburger ONLY on landing page mobile */
				}

				/* For other mobile pages, .desktop-nav remains display: flex */
				.header-content {
					flex-direction: row; /* Keep logo and nav in a row */
					align-items: center;
					justify-content: space-between;
				}
			}

			@media (min-width: 768px) {
				.hamburger-btn {
					display: none; /* Hide hamburger on desktop */
				}

				.mobile-nav-overlay {
					display: none; /* Hide mobile overlay on desktop */
				}

				.desktop-nav {
					display: flex; /* Show desktop nav on desktop */
				}

				.header-content {
					flex-direction: row; /* Ensure row direction for desktop header */					
					flex-wrap: nowrap;
					justify-content: space-between;
				}

				.nav-links {
					width: auto;
					margin-top: 0;
				}

				.logo {
					margin-bottom: 0;
				}
			}
		</style>
	</body>
</html>
