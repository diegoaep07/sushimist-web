---
import { SITE_CONFIG } from '../config';
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
}

const { title = SITE_CONFIG.name } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="main-header">
			<div class="container header-content">
				<a href="/" class="logo">{SITE_CONFIG.name}</a>
				<nav>
					<div class="nav-links">
						<a href="/menu" class="menu-link">Menu</a>
						<a href="/cart" class="cart-link">
							Cart (<span id="cart-count">0</span>)
						</a>
					</div>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<Footer />

		<script>
			// Basic cart count initialization
			function updateCartCount() {
				const cart = JSON.parse(sessionStorage.getItem('cart') || '[]');
				const countElement = document.getElementById('cart-count');
				if (countElement) {
					countElement.textContent = cart.length.toString();
				}
			}

			// Listen for cart updates
			window.addEventListener('cart-updated', updateCartCount);
			// Initial check
			updateCartCount();
		</script>

		<style>
			.main-header {
				padding: var(--space-sm) 0;
				background: var(--card-bg);
				border-bottom: 1px solid var(--border-color);
				position: sticky;
				top: 0;
				z-index: 100;
			}
			.header-content {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap; /* Allow items to wrap on smaller screens */
			}

			.logo {
				font-weight: 700;
				font-size: 1.2rem;
				letter-spacing: -0.5px;
				color: var(--text-color);
				margin-right: var(--space-sm); /* Prevent logo from touching nav */
			}

			.nav-links {
				display: flex;
				gap: var(--space-xs); /* Space between nav items */
			}

			.cart-link,
			.menu-link {
				font-weight: 500;
				padding: 0.5rem 1rem;
				border-radius: var(--radius);
				font-size: var(--small-size);
				white-space: nowrap; /* Prevent text wrapping inside buttons */
			}

			.cart-link {
				background: var(--primary);
				color: var(--secondary);
			}

			.menu-link {
				background: transparent;
				color: var(--primary);
				border: 1px solid var(--primary);
			}

			/* Adjustments for very small screens if needed */
			@media (max-width: 400px) {
				.header-content {
					flex-direction: column;
					align-items: flex-start;
				}
				.nav-links {
					width: 100%;
					justify-content: space-around;
					margin-top: var(--space-sm);
				}
				.logo {
					margin-bottom: var(--space-sm);
				}
			}
		</style>
	</body>
</html>
