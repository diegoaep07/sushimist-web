---
import { SITE_CONFIG } from '../config';
import '../styles/generals.css'
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
}

const { title = SITE_CONFIG.name } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class={Astro.url.pathname === '/' ? 'landing-page' : ''}>
		<header class="main-header">
			<div class="container header-content">
				<a href="/" class="logo">{SITE_CONFIG.name}</a>
				<nav class="main-nav">
					<!-- Desktop navigation -->
						<div class="nav-links desktop-nav">
							{Astro.url.pathname !== '/menu' && (
								<a href="/menu" class="menu-link">Menú</a>
							)}
							{Astro.url.pathname !== '/cart' && (
								<a href="/cart" class="cart-link">
									Carrito (<span id="cart-count">0</span>)
								</a>
							)}
						</div>

					<!-- Hamburger menu for mobile, conditionally shown on landing page -->
					{Astro.url.pathname === '/' && (
						<button id="hamburger-btn" class="hamburger-btn">
							<span class="hamburger-icon"></span>
							<span class="hamburger-icon"></span>
							<span class="hamburger-icon"></span>
						</button>
					)}
					
					<!-- Mobile navigation overlay -->
					<div id="mobile-nav-overlay" class="mobile-nav-overlay">
						<button id="close-mobile-nav" class="close-mobile-nav">&times;</button>
						<div class="mobile-nav-links">
							<a href="/menu" class="menu-link">Menú</a>
							<a href="/cart" class="cart-link">
								Carrito (<span id="mobile-cart-count">0</span>)
							</a>
						</div>
					</div>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<Footer />

		<script>
			// Basic cart count initialization
			function updateCartCount() {
				const cart = JSON.parse(sessionStorage.getItem('cart') || '[]');
				const countElement = document.getElementById('cart-count');
				const mobileCountElement = document.getElementById('mobile-cart-count');

				if (countElement) {
					countElement.textContent = cart.length.toString();
				}
				if (mobileCountElement) {
					mobileCountElement.textContent = cart.length.toString();
				}
			}

			// Hamburger menu functionality
			const hamburgerBtn = document.getElementById('hamburger-btn');
			const closeMobileNavBtn = document.getElementById('close-mobile-nav');
			const mobileNavOverlay = document.getElementById('mobile-nav-overlay');

			if (hamburgerBtn && mobileNavOverlay) {
				hamburgerBtn.addEventListener('click', () => {
					mobileNavOverlay.classList.add('active');
					document.body.style.overflow = 'hidden'; // Prevent scrolling when nav is open
				});
			}

			if (closeMobileNavBtn && mobileNavOverlay) {
				closeMobileNavBtn.addEventListener('click', () => {
					mobileNavOverlay.classList.remove('active');
					document.body.style.overflow = '';
				});
			}

			// Close mobile nav when a link is clicked
			mobileNavOverlay?.querySelectorAll('a').forEach(link => {
				link.addEventListener('click', () => {
					mobileNavOverlay.classList.remove('active');
					document.body.style.overflow = '';
				});
			});

			// Listen for cart updates
			window.addEventListener('cart-updated', updateCartCount);
			// Initial check
			updateCartCount();
</script>
  <style>
    :root {
    --primary: #222E3A;
    --secondary: #FFFFFF;
    --accent: #6A8596; 
    --bg-color: #F0F0F0;
    --text-color: #343A40;
    --text-muted: #555555;
    --border-color: #B1D4E0;
    --card-bg: #FFFFFF;
    
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2.5rem;
    --radius: 8px;

    --font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-heading: "Georgia", serif;
    --h1-size: 2.5rem;
    --h2-size: 1.75rem;
    --body-size: 1rem;
    --small-size: 0.875rem;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-main);
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
}

h1, h2, h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--primary);
}

img {
    max-width: 100%;
    display: block;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    cursor: pointer;
    border: none;
    font-family: inherit;
}

.container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-sm);
}

.menu-list {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-md) 0;
}

.text-center { text-align: center; }
.mt-lg { margin-top: var(--space-lg); }

.main-header {
    padding: var(--space-sm) 0;
    background: var(--card-bg);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
}
.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.logo {
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.5px;
    color: var(--text-color);
    margin-right: var(--space-sm);
}

.nav-links {
    display: flex;
    gap: var(--space-xs);
}

.cart-link,
.menu-link {
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    font-size: var(--small-size);
    white-space: nowrap;
}

.cart-link {
    background: var(--primary);
    color: var(--secondary);
}

.menu-link {
    background: transparent;
    color: var(--primary);
    border: 1px solid var(--primary);
}

.hamburger-btn {
    display: none;
    width: 30px;
    height: 20px;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
}

.hamburger-icon {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--primary);
    border-radius: 2px;
}

.mobile-nav-overlay {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--bg-color);
    z-index: 200;
    transition: left 0.3s ease-in-out;
    padding: var(--space-lg);
    box-sizing: border-box;
}

.mobile-nav-overlay.active {
    left: 0;
}

.close-mobile-nav {
    font-size: 2.5rem;
    background: none;
    border: none;
    color: var(--primary);
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    cursor: pointer;
}

.mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    align-items: flex-start;
}

.mobile-nav-links .menu-link,
.mobile-nav-links .cart-link {
    font-size: 1.5rem; 
    width: 100%;
    text-align: left;
    padding: var(--space-sm) 0;
    background: transparent;
    color: var(--primary);
    border: none;
    border-radius: 0;
}

.mobile-nav-links .cart-link {
    border: 1px solid var(--primary);
    border-radius: var(--radius);
    padding-left: var(--space-sm);
}

.desktop-nav {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    justify-content: flex-end;
}

@media (max-width: 767px) {
    .landing-page .desktop-nav {
        display: none;
    }

    .landing-page .hamburger-btn {
        display: flex;
    }

    .header-content {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }
}

@media (min-width: 768px) {
    .hamburger-btn {
        display: none;
    }

    .mobile-nav-overlay {
        display: none;
    }

    .desktop-nav {
        display: flex;
    }

    .header-content {
        flex-direction: row;
        flex-wrap: nowrap;
        justify-content: space-between;
    }

    .nav-links {
        width: auto;
        margin-top: 0;
    }

    .logo {
        margin-bottom: 0;
    }
}
  </style>
  
	</body>
</html>
